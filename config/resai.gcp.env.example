# Required: set values for your own GCP project before sourcing this file.
RESAI_GCP_PROJECT_NUMBER=
RESAI_VERTEX_PROJECT_ID=
RESAI_VERTEX_LOCATION=global
RESAI_VERTEX_MODEL=gemini-3.5-flash
# AI backend used by the Cloud Run proxy: anthropic (default) or vertex (rollback).
RESAI_AI_PROVIDER=anthropic
RESAI_ANTHROPIC_MODEL=claude-haiku-5-5
# Secret Manager secret name holding the Anthropic API key (never put the key itself here).
RESAI_ANTHROPIC_SECRET_NAME=resai-anthropic-api-key
RESAI_CLOUD_RUN_REGION=asia-northeast1
RESAI_CLOUD_RUN_SERVICE=
RESAI_CLOUD_RUN_SA=
RESAI_PROXY_SECRET_NAME=
